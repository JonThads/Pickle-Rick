# Dependencies
node_modules/
__pycache__/
*.pyc

# Env files - never commit real secrets
.env
.env.local

# Build output
dist/
build/

# Editor/OS cruft
.DS_Store
.vscode/
.idea/

# Logs
*.log
npm-debug.log*

# Test artifacts
playwright-report/
test-results/
testing/playwright/screenshots/

# Playwright test credentials - real accounts/passwords used by specs,
# never committed. See testing/playwright/credentials.example.json for
# the expected shape.
testing/playwright/credentials.json

# User-uploaded files (local dev only - never commit real uploads)
backend-node/uploads/*
!backend-node/uploads/.gitkeep
