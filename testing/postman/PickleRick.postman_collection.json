        {
          "name": "Register - Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Expect 201 in response\r",
                  "pm.test('201 Created', () => pm.response.to.have.status(201));\r",
                  "\r",
                  "// Expect User + Token in response\r",
                  "pm.test('response has user + token', () => {\r",
                  "    const body = pm.response.json();\r",
                  "    pm.expect(body.user.role).to.eql('admin');\r",
                  "    pm.expect(body.token).to.be.a('string')\r",
                  "});\r",
                  "\r",
                  "if (pm.response.code === 201) {\r",
                  "    const body = pm.response.json();\r",
                  "    pm.collectionVariables.set('adminId', body.user.id);\r",
                  "    pm.collectionVariables.set('adminToken', body.token);\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"fullName\": \"PM Admin\",\r\n  \"email\": \"pm-test2-admin@picklerick.test\",\r\n  \"password\": \"Passw0rd!\",\r\n  \"role\": \"admin\",\r\n  \"location\": \"Davao\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          },
          "response": []
