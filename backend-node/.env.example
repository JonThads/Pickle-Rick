# Copy this file to `.env` and fill in real values. Never commit the real `.env`.

PORT=4000

# Matches the `postgres` service name in docker-compose.yml when running in Docker.
DATABASE_URL=postgresql://pickle_rick:pickle_rick_pw@postgres:5432/pickle_rick

# Used to sign/verify JWT auth tokens. Generate your own random string, e.g.
# `openssl rand -hex 32`
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
